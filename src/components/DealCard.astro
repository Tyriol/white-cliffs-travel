---
const {img, alt, title, price, description} = Astro.props;
---

<div class="deal-card">
    <img class="deal-img" src={img} alt={alt} />
    <h3>{title}</h3>
    <p class="price">£{price}</p>
    <p class="deal-description">{description}</p>
</div>

<style>
    .deal-card {
        width: 50%;
    }
</style>